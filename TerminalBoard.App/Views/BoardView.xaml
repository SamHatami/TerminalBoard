<Window
    x:Class="TerminalBoard.App.Views.BoardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Custom="clr-namespace:TerminalBoard.App.UIComponents"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:behaviorsA="clr-namespace:TerminalBoard.App.UIComponents.Behaviors"
    xmlns:cal="http://www.caliburnproject.org"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModelsA="clr-namespace:TerminalBoard.App.ViewModels"
    Title="BoardView"
    Width="800"
    Height="450"
    d:DataContext="{d:DesignInstance Type=viewModelsA:BoardViewModel}"
    TextOptions.TextRenderingMode="Aliased"
    mc:Ignorable="d">
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="KeyDown">
            <cal:ActionMessage MethodName="RemoveItem">
                <cal:Parameter Value="$executionContext" />
            </cal:ActionMessage>
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <Grid Name="MainGrid">
        <Custom:GridCanvas
            x:Name="BackgroundCanvas"
            Background="#FF3A3A3A"
            GridColor="#303030"
            GridSpacing="{Binding GridSpacing}"
            ShowGrid="{Binding Grid}" />
        <Canvas
            x:Name="MainCanvas"
            Background="Transparent"
            Focusable="True"
            MouseRightButtonUp="MainCanvas_OnMouseRightButtonUp"
            Tag="{Binding ElementName=MainGrid, Path=DataContext}">
            <Canvas.ContextMenu>
                <ContextMenu Name="ContextMenu"> <!-- This should be dynamically built, using itemsource and some styling on how the menu item should look like -->
                    <MenuItem Header="Math" IsCheckable="False">
                        <MenuItem Header="Operators" IsCheckable="False">
                            <MenuItem
                                cal:Message.Attach="GetTerminal('BaseMath.Mul')"
                                Header="Multiplication"
                                IsCheckable="False" />
                            <MenuItem cal:Message.Attach="GetTerminal('Division')" Header="Division" />
                            <MenuItem cal:Message.Attach="GetTerminal('Addition')" Header="Addition" />
                            <MenuItem cal:Message.Attach="GetTerminal('Subtraction')" Header="Subtraction" />
                        </MenuItem>
                        <MenuItem Header="Values">
                            <MenuItem cal:Message.Attach="GetTerminal('FloatValue')" Header="Float" />
                            <MenuItem cal:Message.Attach="GetTerminal('IntegerValue')" Header="Integer" />
                        </MenuItem>                        
                        <MenuItem Header="Vault">
                            <MenuItem cal:Message.Attach="GetTerminal('VaultService.SearchFiles')" Header="Search Files" />
                        </MenuItem>
                    </MenuItem>
                </ContextMenu>
            </Canvas.ContextMenu>
            <b:Interaction.Behaviors>
                <behaviorsA:CanvasPanZoomBehavior />
                <behaviorsA:CanvasSelectionBoxBehavior />
            </b:Interaction.Behaviors>

            <ItemsControl x:Name="Wires" ItemsSource="{Binding WireViewModels}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl cal:View.Model="{Binding}" IsHitTestVisible="True">
                            <b:Interaction.Behaviors>
                                <behaviorsA:SelectionBehavior />
                            </b:Interaction.Behaviors>
                        </ContentControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl x:Name="Terminals" ItemsSource="{Binding TerminalViewModels}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style>
                        <Setter Property="Canvas.Left" Value="{Binding CanvasPositionX}" />
                        <Setter Property="Canvas.Top" Value="{Binding CanvasPositionY}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl cal:View.Model="{Binding}" IsHitTestVisible="True">
                            <b:Interaction.Behaviors>
                                <behaviorsA:DragOnCanvasBehavior />
                                <behaviorsA:SelectionBehavior />
                            </b:Interaction.Behaviors>
                        </ContentControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Rectangle
                x:Name="SelectionRectangle"
                Fill="DarkGray"
                Opacity="0.25"
                Stroke="DarkOrange"
                StrokeThickness="1" />
        </Canvas>
        <Canvas x:Name="ControlCanvas">
            <StackPanel Background="#2d2d2a">
                
                <Button
                    x:Name="Run"
                    Margin="5"
                    Content="RUN" 
                    Background="DarkOliveGreen"/>
                <Button
                    x:Name="Snap"
                    Margin="5"
                    Content="SNAP" />
                <Button
                    x:Name="AddTerminal"
                    Margin="5"
                    Content="ADD" />
                <Button
                    x:Name="Float"
                    Margin="5"
                    cal:Message.Attach="AddFloatTerminal()"
                    Content="FLOAT" />
                <Button
                    x:Name="Multiply"
                    Margin="5"
                    cal:Message.Attach="AddMultiplyTerminal()"
                    Content="MULTIPLY" />
                <Button
                    x:Name="Output"
                    Margin="5"
                    cal:Message.Attach="AddOutputTerminal()"
                    Content="OUTPUT" />
            </StackPanel>
        </Canvas>
    </Grid>
</Window>